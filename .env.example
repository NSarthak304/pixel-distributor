# Pixel Distributor - Root Environment Configuration Template
# Copy this file to .env or .env.local for local overrides

NODE_ENV=development
PORT=5001

# Firebase Project Configuration
GCP_PROJECT_ID=pixel-distributor-prod
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Storage Buckets
STORAGE_BUCKET_NAME=pixel-distributor-prod.appspot.com
RELEASES_BUCKET_NAME=pixel-distributor-releases

# Client Origins for CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://admin.pixeldistributor.com,https://app.pixeldistributor.com
